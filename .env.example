# Put these in RunPod "Secrets" / pod environment variables rather than in files.

# Teacher model for task generation and (optional) warm-start trajectories.
# Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, Together, a second vLLM server, ...).
TEACHER_BASE_URL=https://api.openai.com/v1
TEACHER_MODEL=
TEACHER_API_KEY=

# Only needed for gated models or uploading results.
HF_TOKEN=

# Optional: log training to Weights & Biases (also pass --report-to wandb / set REPORT_TO=wandb).
WANDB_API_KEY=
